{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // The tsbuildinfo is part of the build product, not a side effect.
      //
      // `incremental` is on, so tsc reads a tsbuildinfo and emits nothing when it believes the
      // output is current. With only `dist/**` cached, deleting `dist` by hand left the tsbuildinfo
      // behind, tsc then emitted nothing, and turbo cached that as a success with no outputs. Every
      // later run replayed the empty entry, so `dist` never came back and every dependent build
      // failed on a missing `@cleamail/core`. Caching both together keeps them agreeing.
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      // Type-aware linting resolves workspace imports through each package's `exports`, which point
      // at `dist`. Without this, `pnpm lint` passes locally off a warm build and fails in CI, where
      // lint runs before build on a clean checkout.
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "eval:smoke": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
