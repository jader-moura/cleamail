{
  "name": "@cleamail/server",
  "version": "0.1.0",
  "private": true,
  "description": "The local cleamail service: a Fastify API on 127.0.0.1 that reads decisions and reverses them.",
  "type": "module",
  "bin": {
    "cleamail-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js"
  },
  "dependencies": {
    "@cleamail/core": "workspace:*",
    "@cleamail/llm": "workspace:*",
    "@cleamail/providers": "workspace:*",
    "@cleamail/store": "workspace:*",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cleamail/config": "workspace:*",
    "@cleamail/privacy": "workspace:*",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
