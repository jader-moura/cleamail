{
  "name": "@cleamail/providers",
  "version": "0.1.0",
  "private": true,
  "description": "Mail adapters for cleamail: Gmail today, IMAP in SPEC-021. Implements the MailProvider port.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/contract": {
      "types": "./dist/testing/mail-provider-contract.d.ts",
      "import": "./dist/testing/mail-provider-contract.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cleamail/core": "workspace:*",
    "@napi-rs/keyring": "^2.1.2",
    "html-to-text": "^9.0.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cleamail/config": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
