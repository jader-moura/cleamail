{
  "name": "@cleamail/store",
  "version": "0.1.0",
  "private": true,
  "description": "Local SQLite persistence for cleamail: emails, decisions, actions, audit log, corrections, embeddings and settings.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cleamail/core": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cleamail/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
