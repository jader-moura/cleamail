{
  "name": "@cleamail/core",
  "version": "0.1.0",
  "private": true,
  "description": "cleamail domain model: categories, emails, classifications, decisions, actions and the ports adapters implement. No I/O.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cleamail/config": "workspace:*",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
