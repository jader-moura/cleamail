{
  "name": "@cleamail/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig, ESLint, Prettier and Vitest configuration for the cleamail workspace.",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "import": "./vitest/index.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/node-lib.json": "./tsconfig/node-lib.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./eslint/react": "./eslint/react.js"
  },
  "files": [
    "eslint",
    "prettier",
    "tsconfig",
    "vitest"
  ],
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "eslint-plugin-react-hooks": "^7.0.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.0"
  }
